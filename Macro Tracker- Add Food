document.getElementById("weightForm")
  .addEventListener("submit", function(event) {
    event.preventDefault();

    const date = document.getElementById(
      "weightDate"
    ).value;

    const input = document.getElementById(
      "weightValue"
    );

    const weight = Number(input.value);

    if (
      !date ||
      !/^\\d{4}-\\d{2}-\\d{2}$/.test(date) ||
      !Number.isFinite(weight) ||
      weight <= 0 ||
      weight > 1500
    ) {
      setStatus(
        "Please enter a valid date and weight."
      );
      return;
    }

    const duplicate = weights.findIndex(
      (entry, index) =>
        entry.date === date &&
        index !== editingWeightIndex
    );

    if (duplicate >= 0) {
      setStatus(
        "A weight entry already exists for " +
        "that date. Edit it instead."
      );
      return;
    }

    const record = {
      date: date,
      weight: number(weight)
    };

    if (editingWeightIndex !== null) {
      weights[editingWeightIndex] = {
        ...weights[editingWeightIndex],
        ...record
      };

      markDirty("✓ Weight updated.");
    } else {
      weights.push(record);
      markDirty("✓ Weight logged.");
    }

    resetWeightForm();
    renderWeight();
  });

function weightStat(label, value) {
  const card = document.createElement("div");
  card.className = "stat";

