function renderWeightTrend() {
  const root = document.getElementById(
    "weightTrend"
  );

  root.innerHTML = "";

  const today = new Date();
  today.setHours(12, 0, 0, 0);

  const cutoff = new Date(today);
  cutoff.setDate(cutoff.getDate() - 29);

  const startKey = dateKey(cutoff);
  const endKey = dateKey(today);

  const recent = sortedWeights()
    .filter(item =>
      item.entry.date >= startKey &&
      item.entry.date <= endKey
    );

  const card = document.createElement("div");
  card.className = "card";

  if (recent.length === 0) {
    const empty = document.createElement("div");
    empty.className = "empty";
    empty.textContent =
      "Log weigh-ins to see your 30-day trend.";

    card.appendChild(empty);
    root.appendChild(card);
    return;
  }

  const values = recent.map(item =>
    Number(item.entry.weight)
  );

  let min = Math.min(...values);
  let max = Math.max(...values);

  // Keep some vertical padding even if
  // all weigh-ins have the same weight.
  min = Math.floor((min - 1) * 2) / 2;
  max = Math.ceil((max + 1) * 2) / 2;

  if (max <= min) {
    max = min + 2;
  }

  const width = 320;
  const height = 190;

  const left = 36;
  const right = 12;
  const top = 16;
  const bottom = 28;

  const plotWidth = width - left - right;
  const plotHeight = height - top - bottom;

  const MS_DAY = 86400000;

  function utcDay(key) {
    const parts = key.split("-").map(Number);
    return Date.UTC(
      parts[0],
      parts[1] - 1,
      parts[2]
    );
  }

  const startDay = utcDay(startKey);
  const endDay = utcDay(endKey);
  const span = Math.max(1, endDay - startDay);

  function xFor(key) {
    return left +
      (utcDay(key) - startDay) / span *
      plotWidth;
  }

  function yFor(weight) {
    return top +
      (max - weight) / (max - min) *
      plotHeight;
  }

  const NS = "http://www.w3.org/2000/svg";

  function svgElement(name, attributes) {
    const element = document.createElementNS(
      NS, name
    );

    Object.keys(attributes).forEach(key => {
      element.setAttribute(
        key,
        attributes[key]
      );
    });

    return element;
  }

  const svg = svgElement("svg", {
    viewBox: "0 0 " + width + " " + height,
    class: "weightChart",
    role: "img",
    "aria-label": "Weight trend over 30 days"
  });

  for (let i = 0; i <= 3; i++) {
    const y = top +
      (plotHeight / 3) * i;

    const value = max -
      ((max - min) / 3) * i;

    const line = svgElement("line", {
      x1: left,
      y1: y,
      x2: width - right,
      y2: y,
      class: "chartGrid"
    });

    const text = svgElement("text", {
      x: 2,
      y: y + 3,
      class: "chartText"
    });

    text.textContent = number(value);

    svg.appendChild(line);
    svg.appendChild(text);
  }

  const points = recent.map(item => ({
    x: xFor(item.entry.date),
    y: yFor(Number(item.entry.weight))
  }));

  if (points.length > 1) {
    const polyline = svgElement("polyline", {
      points: points.map(p =>
        p.x + "," + p.y
      ).join(" "),
      class: "weightLine"
    });

    svg.appendChild(polyline);
  }

  points.forEach(point => {
    const circle = svgElement("circle", {
      cx: point.x,
      cy: point.y,
      r: 3.5,
      class: "weightPoint"
    });

    svg.appendChild(circle);
  });

  const startLabel = svgElement("text", {
    x: left,
    y: height - 5,
    class: "chartText"
  });

  startLabel.textContent =
    startKey.slice(5);

  const endLabel = svgElement("text", {
    x: width - right,
    y: height - 5,
    "text-anchor": "end",
    class: "chartText"
  });

  endLabel.textContent =
    endKey.slice(5);

  svg.appendChild(startLabel);
  svg.appendChild(endLabel);

  card.appendChild(svg);

  const note = document.createElement("div");
  note.className = "muted";

  note.textContent =
    "Each point represents a recorded weigh-in. " +
    "Missing days are not treated as zero.";

  card.appendChild(note);
  root.appendChild(card);
}

