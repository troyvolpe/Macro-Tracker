<script>

const GOALS = __GOALS__;
const initialEntries = __ENTRIES__;
const initialFavorites = __FAVORITES__;
const initialWeights = __WEIGHTS__;

let foods = initialEntries.slice();
let favorites = initialFavorites.slice();
let weights = initialWeights.slice();

let editingIndex = null;
let editingWeightIndex = null;

window.trackerPayload = "";

function number(value) {
  return Math.round(
    (Number(value) || 0) * 10
  ) / 10;
}

function dateKey(date) {
  return (
    date.getFullYear() + "-" +
    String(date.getMonth() + 1)
      .padStart(2, "0") + "-" +
    String(date.getDate())
      .padStart(2, "0")
  );
}

function entryDateKey(entry) {
  const date = new Date(entry.timestamp);

  return isNaN(date.getTime())
    ? ""
    : dateKey(date);
}

function todayKey() {
  return dateKey(new Date());
}

function setStatus(message) {
  document.getElementById(
    "status"
  ).textContent = message;
}

function markDirty(message) {
  window.trackerPayload = JSON.stringify({
    entries: foods,
    favorites: favorites,
    weights: weights
  });

  setStatus(
    message + " Tap Done to save."
  );
}

function switchTab(id) {
  document.querySelectorAll(
    ".panel"
  ).forEach(el => {
    el.classList.remove("active");
  });

  document.querySelectorAll(
    ".tab"
  ).forEach(el => {
    el.classList.remove("active");
  });

  document.getElementById(id)
    .classList.add("active");

  const index = {
    log: 0,
    history: 1,
    analytics: 2,
    weight: 3
  }[id];

  document.querySelectorAll(
    ".tab"
  )[index].classList.add("active");

  renderAll();
}

function getTotals(key) {
  const totals = {
    calories: 0,
    protein: 0,
    carbs: 0,
    fat: 0
  };

  foods.forEach(entry => {
    if (entryDateKey(entry) !== key) {
      return;
    }

    for (const macro of Object.keys(totals)) {
      totals[macro] +=
        Number(entry[macro]) || 0;
    }
  });

  return totals;
}

function makeProgress(label, current, goal, color) {
  const container = document.createElement("div");

  const row = document.createElement("div");
  row.className = "macroRow";

  const left = document.createElement("span");
  left.textContent = label;

  const right = document.createElement("span");
  right.textContent =
    number(current) + " / " + goal;

  row.appendChild(left);
  row.appendChild(right);

  const bar = document.createElement("div");
  bar.className = "bar";

  const fill = document.createElement("div");
  fill.className = "fill";

  fill.style.width =
    Math.max(
      0,
      Math.min(current / goal, 1)
    ) * 100 + "%";

  fill.style.background = color;

  bar.appendChild(fill);

  container.appendChild(row);
  container.appendChild(bar);

  return container;
}

function makeSummary(totals) {
  const card = document.createElement("div");
  card.className = "card";

  const label = document.createElement("div");
  label.className = "summaryLabel";
  label.textContent = "CALORIES";

  const value = document.createElement("div");
  value.className = "bigNumber";
  value.textContent =
    number(totals.calories) +
    " / " + GOALS.calories;

  card.appendChild(label);
  card.appendChild(value);

  [
    ["Protein", "protein", "#60a5fa"],
    ["Carbs", "carbs", "#facc15"],
    ["Fat", "fat", "#fb923c"]
  ].forEach(item => {
    card.appendChild(
      makeProgress(
        item[0],
        totals[item[1]],
        GOALS[item[1]],
        item[2]
      )
    );
  });

  return card;
}

function readForm() {
  const entry = {
    food:
      document.getElementById("foodName")
        .value.trim() || "Unnamed Food"
  };

  for (const key of [
    "calories", "protein", "carbs", "fat"
  ]) {
    const input = document.getElementById(key);
    const value = Number(input.value);

    if (
      input.value.trim() === "" ||
      !Number.isFinite(value) ||
      value < 0 ||
      value > 100000
    ) {
      setStatus(
        "Please enter valid macro values."
      );
      return null;
    }

    entry[key] = value;
  }

  return entry;
}

function fillForm(entry) {
  document.getElementById("foodName")
    .value = entry.food || "";

  for (const key of [
    "calories", "protein", "carbs", "fat"
  ]) {
    document.getElementById(key)
      .value = entry[key] ?? 0;
  }
}

function resetForm() {
  editingIndex = null;

  document.getElementById(
    "foodForm"
  ).reset();

  document.getElementById(
    "formTitle"
  ).textContent = "Add Food";

  document.getElementById(
    "submitButton"
  ).textContent = "Add Food";
}

document.getElementById("foodForm")
  .addEventListener("submit", function(event) {
    event.preventDefault();

    const entry = readForm();

    if (!entry) return;

    if (editingIndex !== null) {
      const old = foods[editingIndex];

      if (!old) {
        setStatus("Entry no longer exists.");
        resetForm();
        return;
      }

      foods[editingIndex] = {
        ...old,
        ...entry,
        timestamp: old.timestamp
      };

      markDirty("✓ Food updated.");
    } else {
      entry.timestamp =
        new Date().toISOString();

      foods.push(entry);
      markDirty("✓ Food added.");
    }

    resetForm();
    renderAll();
  });

function saveCurrentAsFavorite() {
  const entry = readForm();

  if (!entry) return;

  const existing = favorites.findIndex(
    f => f.food.toLowerCase() ===
      entry.food.toLowerCase()
  );

  if (existing >= 0) {
    favorites[existing] = entry;
    markDirty("✓ Saved food updated.");
  } else {
    favorites.push(entry);
    markDirty("✓ Favorite added.");
  }

  renderFavorites();
}

function renderFavorites() {
  const root = document.getElementById(
    "favorites"
  );

  root.innerHTML = "";

  if (favorites.length === 0) {
    const empty = document.createElement("div");
    empty.className = "empty";
    empty.textContent =
      "No saved foods yet.";

    root.appendChild(empty);
    return;
  }

  favorites.forEach((entry, index) => {
    const card = document.createElement("div");
    card.className = "card";

    const name = document.createElement("div");
    name.className = "name";
    name.textContent = entry.food;

    const macros = document.createElement("div");
    macros.className = "macros";
    macros.textContent =
      number(entry.calories) + " cal | " +
      number(entry.protein) + "g P | " +
      number(entry.carbs) + "g C | " +
      number(entry.fat) + "g F";

    const actions = document.createElement("div");
    actions.className = "actions";

    const use = document.createElement("button");
    use.className = "primary small";
    use.textContent = "Quick Add";

    use.onclick = function() {
      foods.push({
        ...entry,
        timestamp: new Date().toISOString()
      });

      markDirty("✓ Saved food logged.");
      renderAll();
    };

    const fill = document.createElement("button");
    fill.className = "secondary small";
    fill.textContent = "Fill Form";

    fill.onclick = function() {
      resetForm();
      fillForm(entry);
      switchTab("log");
      window.scrollTo(0, 0);
    };

    const remove = document.createElement("button");
    remove.className = "danger small";
    remove.textContent = "Remove";

    remove.onclick = function() {
      showConfirmation(
        card,
        "Remove this saved food?",
        function() {
          favorites.splice(index, 1);
          markDirty("✓ Favorite removed.");
          renderFavorites();
        }
      );
    };

    actions.appendChild(use);
    actions.appendChild(fill);
    actions.appendChild(remove);

    card.appendChild(name);
    card.appendChild(macros);
    card.appendChild(actions);

    root.appendChild(card);
  });
}

function showConfirmation(card, message, callback) {
  const previous = card.querySelector(
    ".confirm"
  );

  if (previous) {
    previous.remove();
    return;
  }

  const box = document.createElement("div");
  box.className = "confirm";

  const text = document.createElement("div");
  text.className = "confirmText";
  text.textContent = message;

  const actions = document.createElement("div");
  actions.className = "actions";

  const cancel = document.createElement("button");
  cancel.className = "secondary";
  cancel.textContent = "Cancel";
  cancel.onclick = function() {
    box.remove();
  };

  const confirm = document.createElement("button");
  confirm.className = "danger";
  confirm.textContent = "Confirm";
  confirm.onclick = callback;

  actions.appendChild(cancel);
  actions.appendChild(confirm);

  box.appendChild(text);
  box.appendChild(actions);
  card.appendChild(box);
}

function renderHistory() {
  const key = document.getElementById(
    "historyDate"
  ).value;

  const summary = document.getElementById(
    "historySummary"
  );

  const list = document.getElementById(
    "historyList"
  );

  summary.innerHTML = "";
  list.innerHTML = "";

  summary.appendChild(
    makeSummary(getTotals(key))
  );

  const selected = foods
    .map((entry, index) => ({
      entry,
      index
    }))
    .filter(item =>
      entryDateKey(item.entry) === key
    )
    .reverse();

  if (selected.length === 0) {
    const empty = document.createElement("div");
    empty.className = "empty";
    empty.textContent =
      "No food logged on this date.";

    list.appendChild(empty);
    return;
  }

  selected.forEach(item => {
    const entry = item.entry;

    const card = document.createElement("div");
    card.className = "card";

    const name = document.createElement("div");
    name.className = "name";
    name.textContent =
      entry.food || "Unnamed Food";

    const time = document.createElement("div");
    time.className = "muted";
    time.textContent = new Date(
      entry.timestamp
    ).toLocaleTimeString([], {
      hour: "numeric",
      minute: "2-digit"
    });

    const macros = document.createElement("div");
    macros.className = "macros";
    macros.textContent =
      number(entry.calories) + " cal | " +
      number(entry.protein) + "g P | " +
      number(entry.carbs) + "g C | " +
      number(entry.fat) + "g F";

    const actions = document.createElement("div");
    actions.className = "actions";

    const edit = document.createElement("button");
    edit.className = "secondary";
    edit.textContent = "Edit";

    edit.onclick = function() {
      editingIndex = item.index;
      fillForm(entry);

      document.getElementById(
        "formTitle"
      ).textContent = "Edit Food";

      document.getElementById(
        "submitButton"
      ).textContent = "Save Changes";

      switchTab("log");
      window.scrollTo(0, 0);
    };

    const remove = document.createElement("button");
    remove.className = "danger";
    remove.textContent = "Delete";

    remove.onclick = function() {
      showConfirmation(
        card,
        "Permanently delete this entry?",
        function() {
          foods.splice(item.index, 1);
          resetForm();
          markDirty("✓ Food deleted.");
          renderAll();
        }
      );
    };

    actions.appendChild(edit);
    actions.appendChild(remove);

    card.appendChild(name);
    card.appendChild(time);
    card.appendChild(macros);
    card.appendChild(actions);

    list.appendChild(card);
  });
}

