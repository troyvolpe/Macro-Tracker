// ============================================
// AUTOMATIC 8 PM NOTIFICATION
// ============================================

async function updateDailyNotification() {
  // Remove any previous pending summary.
  // We replace it with the latest totals.
  await Notification.removePending([
    NOTIFICATION_ID
  ]);

  const scheduledTime = new Date();

  scheduledTime.setHours(
    NOTIFICATION_HOUR,
    NOTIFICATION_MINUTE,
    0,
    0
  );

  // No notification if already past 8 PM.
  if (new Date() >= scheduledTime) {
    return "Past 8 PM";
  }

  // No notification if nothing is logged today.
  if (todayEntries.length === 0) {
    return "No food logged today";
  }

  const notification = new Notification();

  notification.identifier = NOTIFICATION_ID;

  notification.title =
    "Daily Macro Summary";

  function remaining(key, unit) {
    const difference =
      GOALS[key] - totals[key];

    if (difference >= 0) {
      return round(difference) +
        unit + " left";
    }

    return round(Math.abs(difference)) +
      unit + " over";
  }

  notification.body =
    "Calories: " +
    round(totals.calories) +
    " / " + GOALS.calories + "\n" +

    "Protein: " +
    round(totals.protein) +
    " / " + GOALS.protein + "g\n" +

    "Carbs: " +
    round(totals.carbs) +
    " / " + GOALS.carbs + "g\n" +

    "Fat: " +
    round(totals.fat) +
    " / " + GOALS.fat + "g\n\n" +

    "Remaining:\n" +

    "Calories: " +
    remaining("calories", "") + "\n" +

    "Protein: " +
    remaining("protein", "g") + "\n" +

    "Carbs: " +
    remaining("carbs", "g") + "\n" +

    "Fat: " +
    remaining("fat", "g");

  notification.sound = "default";

  notification.setTriggerDate(
    scheduledTime
  );

  await notification.schedule();

  return "Scheduled. ";
}

let notificationStatus = "";

try {
