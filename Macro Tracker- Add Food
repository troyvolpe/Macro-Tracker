function sortedWeights() {
  return weights
    .map((entry, index) => ({
      entry,
      index
    }))
    .filter(item =>
      item.entry &&
      typeof item.entry.date === "string" &&
      Number.isFinite(Number(item.entry.weight)) &&
      Number(item.entry.weight) > 0
    )
    .sort((a, b) =>
      a.entry.date.localeCompare(b.entry.date)
    );
}

function resetWeightForm() {
  editingWeightIndex = null;

  document.getElementById(
    "weightForm"
