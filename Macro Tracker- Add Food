  daysRoot.innerHTML = "";

  const days = [];

  const sums = {
    calories: 0,
    protein: 0,
    carbs: 0,
    fat: 0
  };

  let proteinGoalsMet = 0;
  let daysLogged = 0;

  for (let offset = 6; offset >= 0; offset--) {
    const date = new Date();

    date.setHours(12, 0, 0, 0);
    date.setDate(date.getDate() - offset);

    const key = dateKey(date);
    const totals = getTotals(key);

    const hasEntries = foods.some(
      entry => entryDateKey(entry) === key
    );

    if (hasEntries) {
      daysLogged++;
    }

    for (const macro of Object.keys(sums)) {
      sums[macro] += totals[macro];
    }

    if (totals.protein >= GOALS.protein) {
      proteinGoalsMet++;
    }

    days.push({date, totals});
  }

  const grid = document.createElement("div");
  grid.className = "statGrid";

  const statItems = [
    ["Avg Calories", number(sums.calories / 7)],
    ["Avg Protein", number(sums.protein / 7) + "g"],
    ["Avg Carbs", number(sums.carbs / 7) + "g"],
    ["Avg Fat", number(sums.fat / 7) + "g"],
