// ============================================
// FILE STORAGE
// ============================================

const fm = FileManager.iCloud();

const folder = fm.joinPath(
  fm.documentsDirectory(),
  "MacroTracker"
);

const logPath = fm.joinPath(
  folder,
  "food_log.json"
);

const savedPath = fm.joinPath(
  folder,
  "saved_foods.json"
);

const weightPath = fm.joinPath(
  folder,
  "weight_log.json"
);

if (!fm.fileExists(folder)) {
  fm.createDirectory(folder, true);
}

async function readArray(path) {
  if (!fm.fileExists(path)) {
    return [];
  }

  await fm.downloadFileFromiCloud(path);

  const data = JSON.parse(
    fm.readString(path)
  );

  if (!Array.isArray(data)) {
    throw new Error(
      "Invalid data format in " + path
    );
  }

  return data;
}

let entries;
let savedFoods;
let weightEntries;

try {
  entries = await readArray(logPath);
  savedFoods = await readArray(savedPath);
  weightEntries = await readArray(weightPath);
} catch (error) {
  throw new Error(
    "Unable to load tracker data. " +
    "Your existing files were preserved. " +
    error
  );
}

// ============================================
// UTILITIES
// ============================================

function round(value) {
  return Math.round(
    (Number(value) || 0) * 10
  ) / 10;
}

function localDateKey(date) {
  return (
    date.getFullYear() + "-" +
    String(date.getMonth() + 1)
      .padStart(2, "0") + "-" +
    String(date.getDate())
      .padStart(2, "0")
  );
}

function totalsForDate(data, key) {
  const totals = {
    calories: 0,
    protein: 0,
    carbs: 0,
    fat: 0
  };

  for (const entry of data) {
    const date = new Date(entry.timestamp);

    if (isNaN(date.getTime())) {
      continue;
    }

    if (localDateKey(date) !== key) {
      continue;
    }

    for (const macro of Object.keys(totals)) {
      totals[macro] +=
        Number(entry[macro]) || 0;
    }
  }

  return totals;
}

function safeJSON(value) {
  return JSON.stringify(value)
    .replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");
}

